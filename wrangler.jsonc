{
  "name": "prism",
  // @cloudflare/vite-plugin 的入口指示器，构建时会验证该文件。
  // Vite 会将 worker 打包至 dist/prism/index.js，并在同级生成部署专用的 dist/prism/wrangler.json。
  // 生产环境部署必须使用生成的配置（否则 wrangler 会重新打包源文件并跳过 Vite 的 SSR 服务端渲染逻辑）。
  // 详见 scripts/build.sh —— 它会将生成的配置同步拷贝回此处，
  // 这样在项目根目录直接执行 `wrangler deploy` 就能自动拾取正确的产物，无需在 Cloudflare 控制台添加额外参数。
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  // 将全局 fetch 强制保留在公网路由上（包括本 Zone 的请求），
  // 防止同 Zone 请求绕过 Cloudflare 边缘前置安全防护与风控。
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // capjs-core（内置的 Cap 验证码）在混淆级别 >= 4 时会动态 import() esbuild 与 javascript-obfuscator。
  // 这些是 Node 本地依赖，无法在 Cloudflare Worker 环境中直接运行。
  // 我们将内置 Cap 混淆级别锁定在 <= 3，永远不会触发这些模块，
  // 因此将其别名重定向为空存根（empty stub），既能精简打包体积，又不会破坏任何实际功能。
  "alias": {
    "esbuild": "./worker/lib/stubs/empty.js",
    "javascript-obfuscator": "./worker/lib/stubs/empty.js"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // 默认值是 "auto-trailing-slash"，它会自动将 "/" 解析为 "/index.html"，
    // 导致在 Worker 执行之前就直接返回了静态 HTML 模板，从而破坏了 SSR 服务端渲染。
    // 设置为 "none" 可禁用这种隐式 HTML 路由；
    // 显式请求的静态文件（如 /index.html, /favicon.svg, /assets/index-XXX.js）仍会正常由静态资源层直接托管返回。
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // ── D1 数据库配置 ────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prism-db",
      "database_id": "a2248fd4-49d0-4b78-b4a0-edc1bb50fa6a",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  // ── KV 键值命名空间 ──────────────────────────────────────────────────────────
  "kv_namespaces": [
    {
      // 会话密钥、ID Token 签发用 RSA 密钥对、会话短期元数据
      "binding": "KV_SESSIONS",
      "id": "825bdd6dc6c04142b1e93d75f5770099"
    },
    {
      // 临时缓存、IMAP 轮询游标、验证码与防重放短期状态
      "binding": "KV_CACHE",
      "id": "7154cb9672ee4f7092bee4c62aa4a7a6"
    }
  ],
  // ── R2 对象存储（可选）────────────────────────────────────────────────────────
  // 如果需要支持自定义头像上传或文件托管，可取消注释并填入你的 R2 存储桶名：
  /*
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "prism-assets"
    }
  ],
  */
  // ── Cloudflare Images（可选）─────────────────────────────────────────────────
  // 用于在 管理后台 -> 头像反代 中开启 WebP 格式自动转换。
  // 注意：Images 绑定不支持跨环境继承，若使用独立环境（env）必须在每个环境单独配置。
  /*
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  */
  // ── Cloudflare Secrets Store 密钥存储（可选）──────────────────────────────────
  // 用于对存储在 D1 中的 OAuth 客户端凭据、第三方源密钥等敏感数据进行静态加密（AES-GCM）。
  // 【重要】：如果在 Cloudflare 控制台中尚未创建 Secrets Store 及其密钥，请保持下方注释状态！
  // 否则发布时 Cloudflare API 会报错：[code: 10182] secret not found。
  // 未配置该项时，系统会自动采用平稳的无加密明文/哈希存储，功能完全不受影响。
  /*
  "secrets_store_secrets": [
    {
      "binding": "SECRETS_KEY",
      "store_id": "2b7e151628aed2a6abf7158809cf4f3c",
      "secret_name": "prism-secrets-key"
    }
  ],
  */
  // ── 环境变量（明文配置）───────────────────────────────────────────────────────
  "vars": {
    // 你的站点公开访问根地址（末尾不要带斜杠）
    "APP_URL": "https://cf.cc.cd",
    // 受保护不能被任何人删除的用户（多个用户名用逗号、分号或空格分隔；留空表示不限制）
    "LOCKDOWN_USERS": "",
    // 受保护不能被任何人删除的团队（多个团队名用逗号、分号或空格分隔；留空表示不限制）
    "LOCKDOWN_TEAMS": "",
    // 管理后台 -> 数据库（直接 D1 Web 查询控制台）：
    // 留空、"off"、"false" 或未设置时完全禁用（接口返回 404，界面标签隐藏）；
    // "read-only"：仅允许浏览查看和 SELECT 查询，拒绝任何写入更新；
    // "full"：完全读写权限（审计日志除外，无论何种设置审计日志均为只追加）。
    "D1_CONSOLE": "",
    // 管理后台中的 KV 键值浏览器：
    // 取值与 D1_CONSOLE 一致；留空时自动跟随 D1_CONSOLE 的开关状态。
    "KV_CONSOLE": "",
    // ── Cloudflare 免费层级省流与防爆破开关（零消耗模式）──────────────────────
    // 1. 完全关闭审计事件写入（省去日常 60%~80% 的 D1 写入操作）
    "DISABLE_AUDIT_LOGS": "true",
    // 2. 完全关闭登录失败写库（彻底阻止恶意撞库/暴力破解刷光 10 万次 D1 写入配额）
    "DISABLE_LOGIN_ERRORS": "true",
    // 3. 完全关闭每个请求更新用户 IP 与地理位置历史
    "DISABLE_SESSION_IP_TRACKING": "true",
    // 4. 完全关闭 HTTP 请求详细日志，并免除高频 KV 开关查询与请求体克隆
    "DISABLE_REQUEST_LOGS": "true",
    // 5. 完全关闭邮件/TG/Discord 通知规则的数据库查询与投递流程
    "DISABLE_NOTIFICATIONS": "true",
    // 6. 外部头像与图标直接由源站 CDN 加载，不经过 Worker 代理且不向 D1 写映射
    "DISABLE_IMAGE_PROXY": "true"
  },
  // ── 自定义域名路由 ───────────────────────────────────────────────────────────
  // 将部署绑定到你的域名。如果没有自定义域名或者想用 workers.dev，可将本节注释或保留为空数组 []
  "routes": [
    {
      "pattern": "cf.cc.cd",
      "custom_domain": true
    }
  ],
  // ── 定时触发器（Cron Triggers）───────────────────────────────────────────────
  // 每 6 小时自动执行一次后台轻量维护（如清理过期会话、过期一次性授权码等）
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}